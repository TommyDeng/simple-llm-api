{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simple-llm-api",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-23",
  "upload_source_maps": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "ai.tommydeng.org",
      "custom_domain": true
    }
  ],
  "placement": {
    "region": "aws:ap-northeast-1"
  },
  "vars": {
    "MODEL": "qwen/qwen3.8-27b"
  },
  "secrets": {
    "required": ["GROQ_API_KEY", "APP_PASSWORD"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
